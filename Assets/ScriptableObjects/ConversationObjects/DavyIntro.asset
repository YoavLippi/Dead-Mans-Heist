--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 812e25f310a26d249ab6745d018280f0, type: 3}
  m_Name: DavyIntro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueConversation
  conditions: []
  conversation:
  - ID: Start
    speakerName: Davie
    text: <color=#50C878><b>Harrrk!</b> Be there a <i>landlubber</i> who dare go
      there? Arrr!</color>
    hasOptions: 0
    options: []
    snippetCompletionActions: []
    nextBox: PlayerResponse
  - ID: PlayerResponse
    speakerName: You
    text: <color=#ADD8E6>Arr! I be no landlubber! I be a true blue pirate, just like
      you!</color>
    hasOptions: 0
    options: []
    snippetCompletionActions: []
    nextBox: DavyOh
  - ID: DavyOh
    speakerName: Davie
    text: '<color=#50C878>Shiver me timbers! It be a pirate who plundered me cursed
      treasure?</color> '
    hasOptions: 0
    options: []
    snippetCompletionActions: []
    nextBox: PlayerStutter
  - ID: PlayerStutter
    speakerName: You
    text: '<color=#ADD8E6>Oh, umm. Well in me defense, yer treasure was buried...</color> '
    hasOptions: 0
    options: []
    snippetCompletionActions: []
    nextBox: DavyResponse2
  - ID: DavyResponse2
    speakerName: Davie
    text: '<color=#50C878>...It was?</color> '
    hasOptions: 0
    options: []
    snippetCompletionActions: []
    nextBox: PlayerResponse3
  - ID: PlayerResponse3
    speakerName: You
    text: '<color=#ADD8E6>Aye! And with a marked treasure map beside.</color> '
    hasOptions: 0
    options: []
    snippetCompletionActions: []
    nextBox: DavyResponse3
  - ID: DavyResponse3
    speakerName: Davie
    text: <color=#50C878>Well... be that as it may.</color>
    hasOptions: 0
    options: []
    snippetCompletionActions: []
    nextBox: DavyResponse4
  - ID: DavyResponse4
    speakerName: Davie
    text: <color=#50C878><b>Ye will return it, <color=#8B0000><i>thief,</i></color>
      or ye will be sailing on my ghost fleet for eternities to come!</b></color>
    hasOptions: 0
    options: []
    snippetCompletionActions:
    - type: 5
      parameter: IntroDone
      value: true
    nextBox: Exit
