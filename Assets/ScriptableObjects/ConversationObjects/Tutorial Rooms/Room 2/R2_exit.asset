  conditions: []
  conversation:
  - ID: Start
    speakerName: Davie
    text: <color=#50C878>Yer a natural! Or maybe even supernatural? Ye will want
      to use yer ghost form to distract some pesky guards in the future.</color>
    hasOptions: 0
    options: []
    snippetCompletionActions: []
    nextBox: Tip
  - ID: Tip
    speakerName: Davie
    text: <color=#50C878>And just a word of friendly advice. Any distractions ye
      wish to cause will only be available when yer all dead-like. Ye'll see those
      in blue. If ye wish to hide, those objects will be green.</color>
    hasOptions: 0
    options: []
    snippetCompletionActions: []
    nextBox: Exit
